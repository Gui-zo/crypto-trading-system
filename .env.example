# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Secrets are read through the SecretProvider abstraction (packages/config/secrets.py)
# so this file can be swapped for AWS Secrets Manager later without code changes.

# Application
APP_ENV=local              # local | test | staging | production
TRADING_MODE=RESEARCH      # RESEARCH | BACKTEST | PAPER | SHADOW | SUPERVISED_LIVE | AUTONOMOUS_LIMITED | HALTED
LOG_LEVEL=INFO

# Postgres (matches docker-compose defaults; port 5433 so this stack can run
# alongside the sibling automated-trading-system on 5432)
POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto
POSTGRES_DB=crypto
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://crypto:crypto@localhost:5433/crypto

# Redis
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/1

# Binance. Public market data needs no key. `sync-instruments` needs a read-only,
# IP-restricted key because maintenance-margin brackets are USER_DATA. Put real
# values only in the ignored `.env`, never in this tracked example.
#
# BINANCE_ENV scopes every market-keyed row (ADR-0010). Binance reuses symbols
# across testnet and production; mixing them corrupts every downstream series.
# Testnet and production use SEPARATE credentials; never reuse them.
BINANCE_ENV=testnet        # testnet | production
BINANCE_API_KEY_ID=
BINANCE_API_SECRET_PATH=   # exact chmod-600 file path, never a directory/value

# Raw-payload retention. Local development needs none of this: the default is a
# filesystem store at data/raw relative to the repo root.
RAW_STORE_BACKEND=local    # local | s3
RAW_STORE_LOCAL_DIR=data/raw
# Deployed runtimes only (RAW_STORE_BACKEND=s3). Credentials come from the
# instance role, never from this file.
RAW_STORE_S3_BUCKET=
RAW_STORE_S3_PREFIX=
AWS_REGION=
